# ─────────────────────────────────────────────────────────────────────────────
#  HireAI Production Configuration Template (.env)
# ─────────────────────────────────────────────────────────────────────────────

# 1. Security & Core
SECRET_KEY="super-secret-ai-recruitment-key-change-in-production"
ADMIN_EMAIL_DOMAIN="mycompany.com"
FRONTEND_URL="https://your-frontend-app.vercel.app"

# 2. Database Connection (PostgreSQL for Production / SQLite for Dev)
# For Supabase PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Local Dev: sqlite:///recruitment_platform.db
DATABASE_URL="sqlite:///recruitment_platform.db"

# 3. Real Email Delivery (Gmail SMTP / Resend API)
# Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_SENDER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"

# 4. Universal Cloud Storage (Options: "local", "cloudinary", "s3", "supabase", "r2")
STORAGE_PROVIDER="local"

# 4A. Cloudinary (Recommended for 100% Free Images & Resumes)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 4B. AWS S3 / Cloudflare R2 / Supabase Storage
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL=""
